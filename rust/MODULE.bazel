module(
    name = "rules_runfile_codegen_rust",
    version = "0.1.2",
)

bazel_dep(name = "rules_rust", version = "0.71.3")
bazel_dep(name = "rules_runfile_codegen_core", version = "0.1.2")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "protobuf", version = "33.4", dev_dependency = True)

local_path_override(
    module_name = "rules_runfile_codegen_core",
    path = "../core",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    versions = ["1.88.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)
