# Rust code emitter for rules_runfile_codegen.
load("//internal/emitters:template.bzl", "render")
load("//internal/emitters:utils.bzl", "escape_rust_string")

# rustfmt's default max_width. See
# https://rust-lang.github.io/rustfmt/?version=v1&search=#max_width.
_MAX_WIDTH = 100
_INDENT = "    "

def _header_part(label):
    return render(
        """// Code generated by rules_runfile_codegen. DO NOT EDIT.

//! Typed accessors for the Bazel runfiles of `{{label}}`.
//!
//! Each static is an unresolved spec from the `runfile` crate. Call
//! `resolve()` to find the runfile on disk, or `must_resolve()` to panic if
//! it is missing.""",
        label = label,
    )

def _validate_identifier(name, label):
    """Fails unless `name` is an upper snake case Rust identifier.

    Rust names statics in upper snake case, and rustc warns on other names
    (the `non_upper_case_globals` lint). See
    https://doc.rust-lang.org/reference/identifiers.html.
    """
    if not name:
        fail("Runfile name cannot be empty in '%s'." % label)
    if not (name[0].isupper() and name[0].isalpha()):
        fail("Runfile name '%s' in '%s' must start with an uppercase letter, for example CONFIG_JSON." % (name, label))
    for char in name.elems():
        if not (char.isupper() or char.isdigit() or char == "_"):
            fail("Runfile name '%s' in '%s' must be upper snake case (A-Z, 0-9 and _), for example CONFIG_JSON." % (name, label))

def _display_label(label):
    """Drops the `@@` main repository prefix from labels, for readability."""
    return ", ".join([
        part[2:] if part.startswith("@@//") else part
        for part in label.split(", ")
    ])

def _doc_lines(entry):
    lines = []
    doc = entry["doc"].strip()
    if doc:
        for line in doc.split("\n"):
            line = line.rstrip()
            lines.append("/// " + line if line else "///")
    else:
        lines.append("/// Runfile for `%s`." % _display_label(entry["label"]))
    lines.append("///")
    lines.append("/// Source: `%s`" % _display_label(entry["label"]))
    return lines

def _spec_statement(name, spec_type, rlocation_path):
    """Formats `pub static NAME: T = T::new("path");` the way rustfmt does.

    rustfmt keeps the statement on one line if it fits. Otherwise it breaks
    after `=`, and if the call still does not fit, it moves the argument to
    its own line. A string literal that fits nowhere is left as written.
    """
    head = "pub static %s: %s =" % (name, spec_type)
    call = '%s::new("%s");' % (spec_type, escape_rust_string(rlocation_path))
    one_line = head + " " + call
    if len(one_line) <= _MAX_WIDTH:
        return one_line
    if len(_INDENT) + len(call) <= _MAX_WIDTH:
        return head + "\n" + _INDENT + call
    arg = '"%s",' % escape_rust_string(rlocation_path)
    open_call = "%s %s::new(" % (head, spec_type)
    if len(open_call) <= _MAX_WIDTH and len(_INDENT) + len(arg) <= _MAX_WIDTH:
        return "\n".join([open_call, _INDENT + arg, ");"])
    return one_line

def _file_set_statement(name, files):
    """Formats a `file_set!` static.

    rustfmt does not reformat the body of a macro called with braces, so
    only the first line has to match rustfmt.
    """
    head = "pub static %s: runfile::FileSetSpec =" % name
    first = head + " runfile::file_set! {"
    if len(first) > _MAX_WIDTH:
        first = "pub static %s:\n%srunfile::FileSetSpec = runfile::file_set! {" % (name, _INDENT)
    lines = [first]
    for rel, rlocation_path in sorted(files.items()):
        lines.append('%s"%s" => "%s",' % (_INDENT, escape_rust_string(rel), escape_rust_string(rlocation_path)))
    lines.append("};")
    return "\n".join(lines)

def emit_rust(entries, label):
    """Generates the Rust source of a runfiles crate.

    The output is formatted as `rustfmt` would format it with default
    settings, and each public item has a doc comment.

    Args:
        entries: A list of dicts representing the runfile entries, as
            returned by `analyze_entries`. Each dict must contain:
            - "name": The static's name, in upper snake case.
            - "runfile_path": The canonical rlocation path of the runfile.
            - "is_executable": Whether the target is executable.
            - "is_directory": Whether the target is a directory.
            - "is_collection": Whether the entry is a file set.
            - "collection_files": For a file set, relative path to
              rlocation path.
            - "doc": Optional documentation for the static.
            - "label": The Bazel labels of the targets.
        label: The label of the `rust_runfile_library`, used in the crate
            docs.

    Returns:
        A string containing the complete Rust source.
    """
    blocks = [_header_part(_display_label(label))]
    for entry in entries:
        name = entry["name"]
        _validate_identifier(name, entry["label"])

        if entry["is_collection"]:
            statement = _file_set_statement(name, entry["collection_files"])
        else:
            if entry["is_executable"]:
                spec_type = "runfile::ExecutableSpec"
            elif entry["is_directory"]:
                spec_type = "runfile::DirectorySpec"
            else:
                spec_type = "runfile::FileSpec"
            statement = _spec_statement(name, spec_type, entry["runfile_path"])

        blocks.append("\n".join(_doc_lines(entry) + [statement]))

    return "\n\n".join(blocks) + "\n"
