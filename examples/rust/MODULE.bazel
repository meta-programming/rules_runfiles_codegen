module(
    name = "rules_runfile_codegen_example_rust",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.71.3")
bazel_dep(name = "rules_shell", version = "0.6.1")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.88.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Local overrides to use the current repo's modules
bazel_dep(name = "rules_runfile_codegen_core", version = "0.0.0")
local_path_override(
    module_name = "rules_runfile_codegen_core",
    path = "../../core",
)

bazel_dep(name = "rules_runfile_codegen_rust", version = "0.0.0")
local_path_override(
    module_name = "rules_runfile_codegen_rust",
    path = "../../rust",
)
